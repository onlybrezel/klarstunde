PORT=4173
HOST=127.0.0.1
VSP_BASE_URL=https://virtueller-stundenplan.org
SESSION_TTL_HOURS=8
# Optional: festes Konto für eine persönliche Einzelplatz-Installation.
# VSP_AUTO_LOGIN_EMAIL=name@schule.de
# VSP_AUTO_LOGIN_PASSWORD=passwort
# Optionale Kürzel je Installation. Unbekannte Kürzel bleiben unverändert.
# VSP_SUBJECT_LABELS={"E":"Englisch","PO":"Politik"}
# VSP_ROOM_LABELS={"A101_PC_24":"A 101 · PC-Raum"}
# Optionaler Schutz für einen kurzzeitigen öffentlichen Test:
# PREVIEW_PASSWORD=ein-langes-zufaelliges-passwort
# Nur aktivieren, wenn Klarstunde tatsächlich über HTTPS aufgerufen wird.
# COOKIE_SECURE=true

# Optional: Telegram-Nachrichten bei bestätigten Stundenplanänderungen.
# TELEGRAM_BOT_TOKEN=123456:abc
# TELEGRAM_CHAT_ID=123456789
# TIMETABLE_WATCH_ENABLED=true
# TIMETABLE_WATCH_INTERVAL_MINUTES=15
# TIMETABLE_WATCH_DAYS=14
